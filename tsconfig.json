{
  "compilerOptions": {
    // ES2022, not es6: the Discord message parser uses named capturing groups,
    // which the checker rejects below ES2018. Emit is unaffected — noEmit is on
    // and Next transpiles with SWC against its own browserslist.
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "typescript-plugin-css-modules"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/"
  ],
  "exclude": [
    "node_modules"
  ]
}
